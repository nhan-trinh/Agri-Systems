generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== COOPERATIVE ====================

model Cooperative {
  id           String     @id @default(cuid())
  htx_code     String     @unique   // dùng để sinh farmer_code
  name         String
  province     String
  district     String
  address      String
  phone        String?
  is_active    Boolean    @default(true)
  deleted_at   DateTime?  // soft delete timestamp (BR: soft-delete convention)
  created_at   DateTime   @default(now())
  updated_at   DateTime   @default(now()) @updatedAt
  farmers      Farmer[]
  users        User[]
  materials    Material[]
  harvest_stock_items   HarvestStockItem[]
  harvest_stock_entries HarvestStockEntry[]

  @@index([is_active])
}

// ==================== USER & AUTH ====================

model User {
  id             String      @id @default(cuid())
  phone          String?     @unique
  password_hash  String?
  role           UserRole
  cooperative_id String?
  cooperative    Cooperative? @relation(fields: [cooperative_id], references: [id])
  farmer_id      String?     @unique

  // Zalo Mini App Auth
  zalo_id        String?     @unique
  zalo_name      String?
  avatar_url     String?

  // Display name for phone/password-authenticated users (HTX_MANAGER, etc.).
  // Zalo users use zalo_name; Farmer-linked users mirror Farmer.full_name.
  display_name   String?

  // First login flag — web admin must change password on first login
  is_first_login Boolean     @default(true)

  is_active      Boolean     @default(true)
  last_login_at  DateTime?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  @@index([cooperative_id, role])
  @@index([role, is_active])
}

enum UserRole {
  SUPER_ADMIN
  HTX_MANAGER
  FARMER
  WAREHOUSE_KEEPER
  GOV_VIEWER
}

// ==================== FARMER ====================

model Farmer {
  id             String      @id @default(cuid())
  farmer_code    String      @unique
  full_name      String
  phone          String      @unique
  national_id    String?
  date_of_birth  DateTime?
  address        String
  cooperative_id String
  cooperative    Cooperative @relation(fields: [cooperative_id], references: [id])
  is_active      Boolean     @default(true)
  deleted_at     DateTime?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  farm_zones     FarmZone[]
  harvest_stock_entries HarvestStockEntry[]

  @@index([cooperative_id])
}

// ==================== FARM ZONE ====================

model FarmZone {
  id             String     @id @default(cuid())
  farm_zone_code String     @unique
  zone_name      String
  farmer_id      String
  farmer         Farmer     @relation(fields: [farmer_id], references: [id])
  crop_type      CropType
  boundary       Json       // GeoJSON Polygon — PostGIS via raw query
  area_sqm       Float
  description    String?
  is_active      Boolean    @default(true)
  deleted_at     DateTime?
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt
  seasons        Season[]
}

enum CropType {
  RICE
  COFFEE
  PEPPER
  DURIAN
  VEGETABLE
  OTHER
}

// ==================== SEASON ====================

model Season {
  id                String       @id @default(cuid())
  farm_zone_id      String
  farm_zone         FarmZone     @relation(fields: [farm_zone_id], references: [id])
  season_name       String
  crop_variety      String
  start_date        DateTime
  expected_end_date DateTime
  actual_end_date   DateTime?
  planned_yield_kg  Float
  actual_yield_kg   Float?
  status            SeasonStatus @default(ACTIVE)
  created_by        String
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  farming_logs      FarmingLog[]
  batch             Batch?
  carbon_record     CarbonRecord?
  harvest_stock_entries HarvestStockEntry[]
}

enum SeasonStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ==================== FARMING LOG ====================

model FarmingLog {
  id              String       @id @default(cuid())
  season_id       String
  season          Season       @relation(fields: [season_id], references: [id])
  activity_date   DateTime     @db.Date
  activity_type   ActivityType
  notes           String?
  material_id     String?
  material        Material?    @relation(fields: [material_id], references: [id])
  fertilizer_type String?
  quantity_kg     Float?
  product_name    String?
  dosage          Float?
  unit            String?
  water_volume_m3 Float?
  duration_hours  Float?
  yield_kg        Float?
  harvest_method  String?
  photo_urls      String[]
  created_by      String
  // OCR traceability — links official record back to the scanned evidence (optional).
  ocr_draft_record_id   String? @unique
  ocr_source_document_id String?
  deleted_at      DateTime?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
}

enum ActivityType {
  SEEDING
  FERTILIZING
  PESTICIDE
  IRRIGATION
  HARVESTING
  OTHER
}

// ==================== BATCH & QR ====================

model Batch {
  id                    String      @id @default(cuid())
  batch_code            String      @unique
  season_id             String      @unique
  season                Season      @relation(fields: [season_id], references: [id])
  batch_name            String
  total_weight_kg       Float
  quantity_qr_requested Int
  packaging_unit        String
  product_description   String?
  status                BatchStatus @default(DRAFT)
  checkvn_batch_id      String?
  activated_at          DateTime?
  activation_note       String?
  recalled_at           DateTime?
  recall_reason         String?
  created_by            String
  created_at            DateTime    @default(now())
  updated_at            DateTime    @updatedAt
  qr_codes              QrCode[]
}

model QrCode {
  id              String    @id @default(cuid())
  code            String    @unique
  batch_id        String
  batch           Batch     @relation(fields: [batch_id], references: [id])
  status          QrStatus  @default(INACTIVE)
  activated_at    DateTime?
  recalled_at     DateTime?
  scan_count      Int       @default(0)
  last_scanned_at DateTime?
  created_at      DateTime  @default(now())

  @@index([code])
  @@index([batch_id, status])
}

enum BatchStatus {
  DRAFT
  PENDING_QR
  QR_RECEIVED
  ACTIVATING
  ACTIVE
  RECALLED
}

enum QrStatus {
  INACTIVE
  ACTIVE
  RECALLED
}

// ==================== CARBON ====================

enum EmissionMaterialType {
  FERTILIZER
  PESTICIDE
  HARVEST
}

model EmissionFactor {
  id             String               @id @default(cuid())
  material_type  EmissionMaterialType
  material_name  String
  crop_type      CropType?
  factor_value   Float
  unit           String
  description    String
  source         String
  effective_from DateTime             @default(now())
  is_active      Boolean              @default(true)
  updated_by     String?
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt

  @@unique([material_type, material_name, crop_type])
  @@index([material_type, is_active])
}

model CarbonRecord {
  id                     String       @id @default(cuid())
  season_id              String       @unique
  season                 Season       @relation(fields: [season_id], references: [id])
  total_emitted_kg       Float
  total_sequestered_kg   Float
  net_carbon_tCO2e       Float
  status                 CarbonStatus @default(DRAFT)
  calculation_details    Json
  verified_by            String?
  verified_at            DateTime?
  issued_at              DateTime?
  certificate_no         String?      @unique
  certificate_url        String?
  certificate_expires_at DateTime?
  credit_amount_tCO2e    Float?
  created_at             DateTime     @default(now())

  @@index([status])
  @@index([season_id])
}

enum CarbonStatus {
  DRAFT
  VERIFIED
  ISSUED
}

// ==================== WAREHOUSE ====================

model Material {
  id              String       @id @default(cuid())
  cooperative_id  String
  cooperative     Cooperative  @relation(fields: [cooperative_id], references: [id])
  material_name   String
  material_type   MaterialType
  unit            String       // "kg", "lít", "gói", "bao"
  min_stock_alert Float        @default(0)
  is_active       Boolean      @default(true)
  created_at      DateTime     @default(now())
  stock_item      StockItem?
  transactions    WarehouseTransaction[]
  farming_logs    FarmingLog[]

  @@index([cooperative_id, is_active])
}

model StockItem {
  id            String   @id @default(cuid())
  material_id   String   @unique
  material      Material @relation(fields: [material_id], references: [id])
  current_stock Float    @default(0)
  expiry_date   DateTime?
  updated_at    DateTime @updatedAt
}

model WarehouseTransaction {
  id                  String          @id @default(cuid())
  material_id         String
  material            Material        @relation(fields: [material_id], references: [id])
  transaction_type    TransactionType
  quantity            Float           // luôn dương — service tự trừ/cộng theo type
  unit_price          Float?
  supplier            String?
  invoice_no          String?
  recipient_farmer_id String?
  purpose             String?
  transaction_date    DateTime
  expiry_date         DateTime?       // hạn sử dụng lô hàng nhập
  notes               String?
  created_by          String          // userId
  // OCR traceability — links official record back to the scanned evidence (optional).
  ocr_draft_record_id   String? @unique
  ocr_source_document_id String?
  // KHÔNG có updated_at — BR-005-5: phiếu đã tạo là bất biến
  created_at          DateTime        @default(now())

  @@index([material_id, transaction_type])
  @@index([recipient_farmer_id])
  @@index([transaction_date])
}

enum MaterialType {
  SEED
  FERTILIZER
  PESTICIDE
  EQUIPMENT
  OTHER
}

enum TransactionType {
  IMPORT
  EXPORT
  RETURN
}

// ==================== HARVEST WAREHOUSE ====================
// Kho nông sản — tracks produce flowing OUT of the field into cooperative storage,
// then shipped to buyers. Structurally parallel to the Material Warehouse module
// (StockItem + Transaction history) but a separate domain (FR/UC per spec).

model HarvestStockItem {
  id              String      @id @default(cuid())
  cooperative_id  String
  cooperative     Cooperative @relation(fields: [cooperative_id], references: [id])
  crop_type       CropType
  produce_name    String      // display name as entered, e.g. "Lúa ST25"
  produce_name_key String     // normalized key for uniqueness: trimmed, lowercased, whitespace-collapsed
  unit            String      // "kg", "tấn"
  current_stock   Float       @default(0)
  updated_at      DateTime    @updatedAt
  entries         HarvestStockEntry[]

  @@unique([cooperative_id, crop_type, produce_name_key])
  @@index([cooperative_id])
}

model HarvestStockEntry {
  id                    String           @id @default(cuid())
  cooperative_id        String
  cooperative           Cooperative      @relation(fields: [cooperative_id], references: [id])
  harvest_stock_item_id String
  harvest_stock_item    HarvestStockItem @relation(fields: [harvest_stock_item_id], references: [id])

  entry_type            HarvestEntryType // RECEIVE | SHIP
  quantity              Float            // always positive; type determines +/- stock effect
  unit                  String

  // RECEIVE-specific (nullable when entry_type = SHIP)
  season_id             String?
  season                Season?          @relation(fields: [season_id], references: [id])
  farmer_id             String?
  farmer                Farmer?          @relation(fields: [farmer_id], references: [id])
  quality_notes         String?
  received_after_close  Boolean          @default(false) // FR-12 flag (UC-06)

  // SHIP-specific (nullable when entry_type = RECEIVE)
  buyer_name            String?
  buyer_contact         String?
  unit_price            Float?

  entry_date            DateTime
  notes                 String?
  created_by            String           // userId
  // No updated_at — immutable once created (mirrors WarehouseTransaction BR-005-5)
  created_at            DateTime         @default(now())

  @@index([harvest_stock_item_id, entry_type])
  @@index([season_id])
  @@index([cooperative_id, entry_date])
}

enum HarvestEntryType {
  RECEIVE
  SHIP
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id         String   @id @default(cuid())
  user_id    String
  event      String
  title      String
  body       String
  metadata   Json?
  is_read    Boolean  @default(false)
  read_at    DateTime?
  created_at DateTime @default(now())

  @@index([user_id, is_read])
  @@index([user_id, created_at])
}

// ==================== OCR & EXPORT JOBS ====================

// ── OCR pipeline (BR-007) ──────────────────────────
// A user uploads a batch of files → each becomes one OcrDocument. A background
// worker OCRs each document, classifies it, and produces OcrDraftRecord(s) that a
// reviewer edits then confirms. Confirmation creates the official FarmingLog /
// WarehouseTransaction. OcrAuditLog keeps the raw-vs-confirmed diff.

model OcrBatch {
  id              String        @id @default(cuid())
  cooperative_id  String
  uploaded_by     String
  status          OcrBatchStatus @default(QUEUED)
  total_files     Int
  processed_files Int           @default(0)
  failed_files    Int           @default(0)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  documents       OcrDocument[]

  @@index([cooperative_id, status])
}

model OcrDocument {
  id              String            @id @default(cuid())
  batch_id        String
  batch           OcrBatch          @relation(fields: [batch_id], references: [id])
  cooperative_id  String
  uploaded_by     String

  original_filename String
  mime_type         String
  file_size_bytes   Int
  page_count        Int?
  file_sha256       String?
  object_key        String

  document_type     OcrDocumentType  @default(UNKNOWN)
  status            OcrDocumentStatus @default(QUEUED)
  error_code        String?
  error_message     String?

  raw_ocr_text      String?
  raw_ocr_data      Json?
  provider_name     String?
  provider_metadata Json?

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  draft_records     OcrDraftRecord[]
  audit_logs        OcrAuditLog[]

  @@index([cooperative_id, status])
  @@index([batch_id])
}

model OcrDraftRecord {
  id                  String          @id @default(cuid())
  document_id         String
  document            OcrDocument     @relation(fields: [document_id], references: [id])

  target_entity       OcrTargetEntity
  status              OcrDraftStatus  @default(DRAFT)

  raw_extracted_data  Json
  ai_normalized_data  Json
  confirmed_data      Json?
  validation_errors   Json?
  confidence_score    Float?

  official_record_id  String?
  confirmed_by        String?
  confirmed_at        DateTime?
  rejected_by         String?
  rejected_at         DateTime?
  rejection_reason    String?

  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@index([document_id, status])
  @@index([target_entity, official_record_id])
}

model OcrAuditLog {
  id            String   @id @default(cuid())
  document_id   String
  document      OcrDocument @relation(fields: [document_id], references: [id])

  actor_user_id String
  action        String
  before_data   Json?
  after_data    Json?
  diff          Json?
  ip_address    String?
  user_agent    String?
  created_at    DateTime @default(now())

  @@index([document_id])
}

enum OcrBatchStatus {
  QUEUED
  PROCESSING
  AWAITING_REVIEW
  PARTIALLY_FAILED
  CONFIRMED
  ERROR
}

enum OcrDocumentStatus {
  QUEUED
  PROCESSING
  AWAITING_REVIEW
  CONFIRMED
  REJECTED
  ERROR
}

enum OcrDocumentType {
  FARMING_LOGBOOK
  MATERIAL_INVOICE
  UNKNOWN
}

enum OcrTargetEntity {
  FARMING_LOG
  WAREHOUSE_TRANSACTION
}

enum OcrDraftStatus {
  DRAFT
  CONFIRMING
  CONFIRMED
  REJECTED
}

// ── Export jobs (Carbon reports) ───────────────────

model ExportJob {
  id           String       @id @default(cuid())
  report_type  String
  format       ExportFormat
  filters      Json
  status       ExportStatus @default(PENDING)
  download_url String?
  expires_at   DateTime?
  created_by   String
  created_at   DateTime     @default(now())
}

enum ExportFormat {
  EXCEL
  PDF
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
